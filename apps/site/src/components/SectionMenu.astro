---
import { MENU_ICONS } from "../products";

/**
 * The menu at the top of the sidebar: it shows the section you are in, and opens to a list of every section, each
 * with the same icon and colors as its card on the front page. Each section has its own sidebar below.
 */
const data = Astro.locals.starlightSidebarTopics;
const show = Astro.locals.starlightRoute.hasSidebar && data?.isPageWithTopic;
const topics = (data?.topics ?? []).map((topic) => ({ ...topic, art: MENU_ICONS.get(topic.link) }));
const current = topics.find((t) => t.isCurrent);

/** Where the menu is broken into groups: Start here, then the editors, then scripts and the platform. */
const groupStart = new Set(["/documents/", "/scripts/"]);
---

{
  show && current && (
    <section-menu class="section-menu">
      <button type="button" class="current" aria-expanded="false" aria-haspopup="true" aria-controls="section-menu-list">
        {current.art && (
          <span class="tile" style={`--from:${current.art.from};--to:${current.art.to}`}>
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={current.art.icon} />
          </span>
        )}
        <span class="label">{current.label}</span>
        <svg class="chevron" viewBox="0 0 16 16" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
          <path d="m4 6 4 4 4-4" />
        </svg>
      </button>
      <ul id="section-menu-list" class="list" hidden>
        {topics.map((topic) => (
          <li class:list={{ gap: groupStart.has(topic.link) }}>
            <a href={topic.link} aria-current={topic.isCurrent ? "page" : undefined} style={topic.art ? `--from:${topic.art.from}` : undefined}>
              {topic.art && (
                <span class="tile" style={`--from:${topic.art.from};--to:${topic.art.to}`}>
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" set:html={topic.art.icon} />
                </span>
              )}
              <span class="label">{topic.label}</span>
              {topic.badge && <span class="badge">{topic.badge.text}</span>}
            </a>
          </li>
        ))}
      </ul>
    </section-menu>
  )
}

<style>
  .section-menu {
    position: relative;
    display: block;
    margin-bottom: 1rem;
  }

  .current {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    width: 100%;
    padding: 0.4rem 0.55rem;
    border: 1px solid var(--pli-line-strong);
    border-radius: var(--pli-radius-sm);
    background: var(--pli-surface);
    color: var(--pli-ink);
    box-shadow: var(--pli-shadow-sm);
    font: inherit;
    font-weight: 600;
    cursor: pointer;
    transition: border-color var(--pli-dur-fast), background-color var(--pli-dur-fast), box-shadow var(--pli-dur-fast);
  }

  .current:hover,
  .current[aria-expanded="true"] {
    border-color: color-mix(in srgb, var(--pli-brand) 50%, var(--pli-line-strong));
    background: var(--pli-surface-2);
  }

  .current:focus-visible,
  .list a:focus-visible {
    outline: 2px solid var(--pli-brand);
    outline-offset: 2px;
  }

  /* The same card as on the front page, small: gradient, light edge, white icon. */
  .tile {
    flex: none;
    display: grid;
    place-items: center;
    width: 1.9rem;
    height: 1.9rem;
    border-radius: 0.55rem;
    color: #fff;
    background:
      radial-gradient(120% 90% at 0% 0%, rgb(255 255 255 / 0.3), transparent 60%),
      linear-gradient(135deg, var(--from), var(--to));
    box-shadow: inset 0 0 0 1px rgb(255 255 255 / 0.18), 0 4px 10px -4px var(--from);
  }

  .tile svg {
    width: 1.15rem;
    height: 1.15rem;
  }

  .tile :global(.pdf-letters) {
    stroke: var(--to);
  }

  .label {
    flex: 1;
    text-align: start;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .chevron {
    flex: none;
    width: 1rem;
    height: 1rem;
    color: var(--pli-muted);
    transition: transform var(--pli-dur-fast) var(--pli-ease);
  }

  .current[aria-expanded="true"] .chevron {
    transform: rotate(180deg);
  }

  .list {
    position: absolute;
    z-index: 20;
    inset-inline: 0;
    top: calc(100% + 0.4rem);
    max-height: min(70vh, 30rem);
    overflow-y: auto;
    margin: 0;
    padding: 0.35rem;
    list-style: none;
    border: 1px solid var(--pli-line-strong);
    border-radius: var(--pli-radius);
    background: var(--pli-surface);
    box-shadow: var(--pli-shadow-md);
  }

  .list[hidden] {
    display: none;
  }

  .list li {
    margin: 0;
    padding: 0;
  }

  /* A line between the groups: Start here, the editors, and scripts and the platform. */
  .list li.gap {
    margin-top: 0.35rem;
    padding-top: 0.35rem;
    border-top: 1px solid var(--pli-line);
  }

  .list a {
    display: flex;
    align-items: center;
    gap: 0.6rem;
    padding: 0.3rem 0.4rem;
    border-radius: 0.5rem;
    color: var(--pli-ink-2);
    font-weight: 550;
    text-decoration: none;
  }

  .list a:hover {
    background: var(--pli-surface-2);
    color: var(--pli-ink);
  }

  .list a[aria-current="page"] {
    background: var(--pli-surface-2);
    color: var(--pli-ink);
    box-shadow: inset 3px 0 0 var(--from, var(--pli-brand));
  }

  .badge {
    flex: none;
    padding: 0 0.45rem;
    border-radius: 999px;
    background: var(--pli-surface-2);
    color: var(--pli-muted);
    font-size: var(--sl-text-xs);
    font-weight: 500;
  }

  @media (prefers-reduced-motion: reduce) {
    .current,
    .chevron {
      transition: none;
    }
  }
</style>

<script>
  class SectionMenu extends HTMLElement {
    connectedCallback() {
      const button = this.querySelector<HTMLButtonElement>("button.current");
      const list = this.querySelector<HTMLElement>(".list");
      if (!button || !list) return;
      const set = (open: boolean) => {
        list.hidden = !open;
        button.setAttribute("aria-expanded", String(open));
      };
      button.addEventListener("click", () => set(list.hidden));
      document.addEventListener("click", (event) => {
        if (!(event.target instanceof Node) || !this.contains(event.target)) set(false);
      });
      this.addEventListener("keydown", (event) => {
        if (event.key === "Escape" && !list.hidden) {
          set(false);
          button.focus();
        }
      });
    }
  }
  customElements.define("section-menu", SectionMenu);
</script>
