---
// The Pli mark, the same one as in the docs header (SiteTitle.astro): a sheet with its corner folded over (a "pli" is a fold)
// on the brand gradient, with the P drawn on it. Drawn inline so it follows the page without a request.
interface Props {
  size?: number;
  /** Gradient ids must be unique per page when the mark is drawn twice. */
  id?: string;
}
const { size = 28, id = "pli-logo" } = Astro.props;
---
<svg class="pli-logo" width={size} height={size} viewBox="0 0 28 28" aria-hidden="true" focusable="false">
  <defs>
    <linearGradient id={id} x1="0" y1="0" x2="1" y2="1">
      <stop offset="0" style="stop-color: var(--pli-brand)"></stop>
      <stop offset="1" style="stop-color: var(--pli-brand-2)"></stop>
    </linearGradient>
  </defs>
  <path d="M7 2h10l9 9v12a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3z" fill={`url(#${id})`}></path>
  <path d="M17 2v6a3 3 0 0 0 3 3h6z" fill="#fff" opacity=".35"></path>
  <path d="M10 21v-8h3.6a2.6 2.6 0 0 1 0 5.2H10" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
</svg>
