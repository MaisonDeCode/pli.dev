---
// "Bring your own backend": a diagram of what Pli does and does not own, with the real interface names, plus a text version of
// the same thing. Two drawings share one set of facts: a wide one (columns) and a tall one for phones (rows), switched by CSS.
// Packets move with transform only, inside prefers-reduced-motion: no-preference; otherwise they rest on the line.
// Interface names are checked against packages/core/src in test/sections.test.ts.

const wide = {
  // x ranges of the two gaps the packets cross, and the three row centres
  left: [248, 336], right: [624, 712], ys: [110, 220, 330],
};
const users = [
  { t: "Browser", s: "React editors" },
  { t: "iPhone, iPad, Mac", s: "Swift" },
  { t: "Android", s: "Kotlin" },
];
const yours = [
  { t: "Your comments store", i: "CommentStore", s: "load · save" },
  { t: "Your realtime transport", i: "Transport", s: "connect · send · disconnect" },
  { t: "Your storage", i: "StorageAdapter", s: "pictures and files" },
];
const core = ["Users and roles", "Comments", "Presence", "Live editing", "Files"];

const packetCss = [
  `@media (prefers-reduced-motion:no-preference){`,
  `.bk .pkt{animation-duration:3.2s;animation-iteration-count:infinite;animation-timing-function:linear;animation-fill-mode:both}`,
  `html.pli-js .diagram:not(.pli-in) .pkt{animation-play-state:paused}`,
  ...(["lf", "lb", "rf", "rb"] as const).map((k) => {
    const [a, b] = k[0] === "l" ? wide.left : wide.right;
    const [from, to] = k[1] === "f" ? [a, b] : [b, a];
    return `@keyframes bk-w-${k}{0%{opacity:0;transform:translate3d(${from}px,0,0)}12%,86%{opacity:1}100%{opacity:0;transform:translate3d(${to}px,0,0)}}`;
  }),
  ...(["lf", "lb", "rf", "rb"] as const).map((k) => {
    const [a, b] = k[0] === "l" ? [86, 150] : [390, 470];
    const [from, to] = k[1] === "f" ? [a, b] : [b, a];
    return `@keyframes bk-t-${k}{0%{opacity:0;transform:translate3d(0,${from}px,0)}12%,86%{opacity:1}100%{opacity:0;transform:translate3d(0,${to}px,0)}}`;
  }),
  `.bk .w-lf{animation-name:bk-w-lf}.bk .w-lb{animation-name:bk-w-lb}.bk .w-rf{animation-name:bk-w-rf}.bk .w-rb{animation-name:bk-w-rb}`,
  `.bk .t-lf{animation-name:bk-t-lf}.bk .t-lb{animation-name:bk-t-lb}.bk .t-rf{animation-name:bk-t-rf}.bk .t-rb{animation-name:bk-t-rb}`,
  `.bk .back{animation-delay:calc(var(--d,0s) + 1.6s)}.bk .fwd{animation-delay:var(--d,0s)}`,
  `}`,
].join("\n");

const cards = [
  {
    iface: "Users",
    title: "Who is here",
    text: "You tell Pli who is signed in and how to look people up by id. Pli stores only ids; names and pictures are looked up when drawn.",
    href: "/platform/users/",
  },
  {
    iface: "CommentStore",
    title: "Where comments live",
    text: "Write load and save. Pli calls save once per change, in order, and takes the change back if you refuse it. Or keep comments inside the file.",
    href: "/platform/comments/",
  },
  {
    iface: "Transport",
    title: "How messages travel",
    text: "Write connect, send and disconnect over Socket.io, a WebSocket, Redis or anything that carries JSON. For live text editing, a small sequencer on your server (createAuthority) puts changes in order.",
    href: "/platform/realtime/",
  },
  {
    iface: "StorageAdapter",
    title: "Where files go",
    text: "A StorageClient over your adapter uploads pictures and files, with limits on type and size, so documents hold addresses, not megabytes.",
    href: "/documents/guides/storing-files/",
  },
];
const label =
  "Diagram. On the left, people in a browser, on an iPhone, iPad or Mac, and on Android use the Pli editor. In the middle, the editor and @pli.dev/core. On the right, three things you own: a comments store, a realtime transport and file storage. Messages travel both ways between them. The same facts are listed below the diagram.";
---
<section class="pli-section bk" id="backend" aria-labelledby="bk-h">
  <div class="pli-container">
    <header class="head" data-reveal>
      <p class="pli-eyebrow">Bring your own backend</p>
      <h2 class="pli-h2" id="bk-h">Pli does the editing. You keep the data.</h2>
      <p class="pli-lede">Pli never opens a connection of its own and never stores anything. Comments, live updates and files all go through small interfaces that you implement with the database and the socket you already run.</p>
    </header>

    <figure class="diagram pli-card" data-reveal="fade">
      <!-- Wide drawing -->
      <svg class="wide" viewBox="0 0 960 440" role="img" aria-label={label} focusable="false">
        <text class="lab" x="16" y="30">YOUR USERS</text>
        <text class="lab" x="336" y="30">PLI, INSIDE YOUR APP</text>
        <text class="lab" x="712" y="30">YOUR BACKEND</text>

        {/* Pli */}
        <rect class="bx bx--pli" x="336" y="44" width="288" height="360" rx="20" />
        <text class="t1" x="360" y="80">The Pli editor</text>
        <text class="t2" x="360" y="102">Documents, Sheets, Decks, PDF</text>
        <rect class="bx bx--core" x="360" y="122" width="240" height="258" rx="14" />
        <text class="mono big" x="378" y="152">@pli.dev/core</text>
        {core.map((c, i) => (
          <g>
            <rect class="chip" x="378" y={170 + i * 40} width="204" height="30" rx="8" />
            <text class="t3" x="394" y={190 + i * 40}>{c}</text>
          </g>
        ))}

        {/* Users and yours */}
        {wide.ys.map((y, i) => (
          <g>
            <rect class="bx" x="16" y={y - 44} width="232" height="88" rx="14" />
            <text class="t1" x="36" y={y - 4}>{users[i]!.t}</text>
            <text class="t2" x="36" y={y + 18}>{users[i]!.s}</text>
            <rect class="bx bx--yours" x="712" y={y - 44} width="232" height="88" rx="14" />
            <text class="t1" x="732" y={y - 12}>{yours[i]!.t}</text>
            <text class="mono" x="732" y={y + 10}>{yours[i]!.i}</text>
            <text class="t2" x="732" y={y + 30}>{yours[i]!.s}</text>

            <line class="wire" x1="248" y1={y} x2="330" y2={y} />
            <path class="head-p" d={`M330 ${y - 5}L338 ${y}L330 ${y + 5}`} />
            <path class="head-p" d={`M254 ${y - 5}L246 ${y}L254 ${y + 5}`} />
            <line class="wire" x1="624" y1={y} x2="706" y2={y} />
            <path class="head-p" d={`M706 ${y - 5}L714 ${y}L706 ${y + 5}`} />
            <path class="head-p" d={`M630 ${y - 5}L622 ${y}L630 ${y + 5}`} />

            {(["l", "r"] as const).map((side) => (
              <g transform={`translate(0 ${y})`}>
                <circle class={`pkt fwd w-${side}f`} cx="0" cy="0" r="5" transform={`translate(${side === "l" ? 292 : 668} 0)`} style={`--d:${i * 0.55}s`} />
                <circle class={`pkt back w-${side}b`} cx="0" cy="0" r="4" transform={`translate(${side === "l" ? 292 : 668} 0)`} style={`--d:${i * 0.55}s`} />
              </g>
            ))}
          </g>
        ))}
      </svg>

      <!-- Tall drawing for phones -->
      <svg class="tall" viewBox="0 0 340 600" role="img" aria-label={label} focusable="false">
        <text class="lab" x="4" y="14">YOUR USERS</text>
        {users.map((u, i) => (
          <g>
            <rect class="bx" x={4 + i * 112} y="24" width="108" height="62" rx="12" />
            <text class="t1 sm" x={4 + i * 112 + 54} y="50" text-anchor="middle">{i === 1 ? "iPhone, iPad" : u.t}</text>
            <text class="t2 sm" x={4 + i * 112 + 54} y="70" text-anchor="middle">{u.s}</text>
            <line class="wire" x1={58 + i * 112} y1="92" x2={58 + i * 112} y2="144" />
            <path class="head-p" d={`M${53 + i * 112} 138L${58 + i * 112} 146L${63 + i * 112} 138`} />
            <path class="head-p" d={`M${53 + i * 112} 98L${58 + i * 112} 90L${63 + i * 112} 98`} />
            <line class="wire" x1={58 + i * 112} y1="396" x2={58 + i * 112} y2="466" />
            <path class="head-p" d={`M${53 + i * 112} 460L${58 + i * 112} 468L${63 + i * 112} 460`} />
            <path class="head-p" d={`M${53 + i * 112} 402L${58 + i * 112} 394L${63 + i * 112} 402`} />
            <g transform={`translate(${58 + i * 112} 0)`}>
              <circle class="pkt fwd t-lf" cx="0" cy="0" r="4.5" transform="translate(0 118)" style={`--d:${i * 0.55}s`} />
              <circle class="pkt back t-lb" cx="0" cy="0" r="3.5" transform="translate(0 118)" style={`--d:${i * 0.55}s`} />
              <circle class="pkt fwd t-rf" cx="0" cy="0" r="4.5" transform="translate(0 430)" style={`--d:${i * 0.55}s`} />
              <circle class="pkt back t-rb" cx="0" cy="0" r="3.5" transform="translate(0 430)" style={`--d:${i * 0.55}s`} />
            </g>
          </g>
        ))}

        <rect class="bx bx--pli" x="4" y="150" width="332" height="242" rx="16" />
        <text class="lab in" x="20" y="172">PLI, INSIDE YOUR APP</text>
        <text class="t1" x="20" y="198">The Pli editor</text>
        <rect class="bx bx--core" x="18" y="212" width="304" height="164" rx="12" />
        <text class="mono big" x="32" y="238">@pli.dev/core</text>
        {core.map((c, i) => (
          <g>
            <rect class="chip" x={30 + (i % 2) * 146} y={252 + Math.floor(i / 2) * 40} width="136" height="30" rx="8" />
            <text class="t3 sm" x={42 + (i % 2) * 146} y={272 + Math.floor(i / 2) * 40}>{c}</text>
          </g>
        ))}

        {yours.map((y, i) => (
          <g>
            <rect class="bx bx--yours" x={4 + i * 112} y="472" width="108" height="100" rx="12" />
            <text class="t1 sm" x={4 + i * 112 + 54} y="496" text-anchor="middle">{["Your comments", "Your realtime", "Your storage"][i]}</text>
            <text class="t1 sm" x={4 + i * 112 + 54} y="513" text-anchor="middle">{["store", "transport", ""][i]}</text>
            <text class="mono sm" x={4 + i * 112 + 54} y="542" text-anchor="middle">{y.i}</text>
          </g>
        ))}
        <text class="lab" x="4" y="592">YOUR BACKEND</text>
      </svg>

    </figure>

    <ul class="cards">
      {cards.map((c, i) => (
        <li data-reveal style={`--i:${i}`}>
          <a class="pli-card card" href={c.href}>
            <code class="iface">{c.iface}</code>
            <h3>{c.title}</h3>
            <p>{c.text}</p>
            <span class="go">Read the docs <span aria-hidden="true">→</span></span>
          </a>
        </li>
      ))}
    </ul>

    <p class="more" data-reveal>
      Sheets, Decks and PDF use the same four interfaces. The engine runs in JavaScript, in JavaScriptCore on iOS and in QuickJS on Android, so a Swift or Kotlin app plugs in its own transport and store the same way (<a class="pli-link" href="/platform/swift-and-kotlin/">Swift and Kotlin reference</a>). The whole picture is on the <a class="pli-link" href="/platform/architecture/">architecture page</a>.
    </p>
  </div>
  <style is:inline set:html={packetCss}></style>
</section>

<style>
  .head { display: grid; gap: var(--pli-s4); max-width: 48rem; margin-bottom: var(--pli-s7); }
  .diagram { margin: 0; padding: clamp(0.75rem, 2vw, 2rem); overflow: hidden; }
  .diagram svg { display: block; width: 100%; height: auto; overflow: visible; }
  .wide { display: none !important; }
  @media (min-width: 840px) {
    .wide { display: block !important; }
    .tall { display: none !important; }
  }

  .bx { fill: var(--pli-surface); stroke: var(--pli-line-strong); stroke-width: 1.5; }
  .bx--pli { fill: color-mix(in srgb, var(--pli-brand) 7%, var(--pli-surface)); stroke: var(--pli-brand); stroke-width: 2; }
  .bx--core { fill: var(--pli-surface); stroke: color-mix(in srgb, var(--pli-brand) 40%, transparent); stroke-width: 1.5; }
  .bx--yours { fill: color-mix(in srgb, var(--pli-sheets) 7%, var(--pli-surface)); stroke: var(--pli-sheets); stroke-dasharray: 6 5; }
  .chip { fill: color-mix(in srgb, var(--pli-brand) 10%, var(--pli-surface-2)); }
  .lab { font: 700 11.5px var(--pli-font); letter-spacing: 0.12em; fill: var(--pli-muted); }
  .lab.in { fill: var(--pli-brand); }
  .t1 { font: 680 16px var(--pli-font); fill: var(--pli-ink); }
  .t2 { font: 13px var(--pli-font); fill: var(--pli-muted); }
  .t3 { font: 600 14px var(--pli-font); fill: var(--pli-ink-2); }
  .mono { font: 600 13px var(--pli-mono); fill: color-mix(in srgb, var(--pli-sheets) 75%, var(--pli-ink)); }
  .mono.big { font-size: 14.5px; fill: var(--pli-brand); }
  .sm.t1, .t1.sm { font-size: 13.5px; }
  .t2.sm { font-size: 12px; }
  .t3.sm { font-size: 12.5px; }
  .mono.sm { font-size: 11.5px; }
  .wire { stroke: var(--pli-line-strong); stroke-width: 2; stroke-linecap: round; }
  .head-p { fill: none; stroke: var(--pli-line-strong); stroke-width: 2; stroke-linecap: round; stroke-linejoin: round; }
  .pkt { transform-box: view-box; }
  .fwd { fill: var(--pli-brand); }
  .back { fill: var(--pli-sheets); }

  .cards { list-style: none; margin: var(--pli-s5) 0 0; padding: 0; display: grid; gap: var(--pli-s4); grid-template-columns: repeat(auto-fit, minmax(min(100%, 15rem), 1fr)); }
  .cards > li { display: flex; }
  .card { display: flex; flex-direction: column; gap: 0.4rem; width: 100%; }
  .card:focus-visible { outline: 2px solid var(--pli-brand); outline-offset: 3px; }
  .iface { align-self: flex-start; font: 650 0.8rem/1 var(--pli-mono); padding: 0.35rem 0.55rem; border-radius: 0.45rem; color: var(--pli-sheets); background: var(--pli-sheets-soft); }
  .card h3 { margin-top: 0.3rem; }
  .go { margin-top: auto; padding-top: 0.5rem; font-weight: 600; font-size: 0.9rem; color: var(--pli-brand); }
  .go span { display: inline-block; transition: transform var(--pli-dur-fast) var(--pli-ease); }
  .card:hover .go span { transform: translateX(4px); }
  .more { margin: var(--pli-s5) 0 0; max-width: 52rem; color: var(--pli-muted); font-size: 0.97rem; }
  .more a { font-weight: 600; }
</style>
