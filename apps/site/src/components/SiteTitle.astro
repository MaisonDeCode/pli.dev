---
/** The name in the docs header: Pli's mark (a folded corner, as in a pli, a fold) and the wordmark. */
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title" aria-label={`${siteTitle} home`}>
  <svg viewBox="0 0 28 28" width="26" height="26" aria-hidden="true" focusable="false">
    <defs>
      <linearGradient id="pli-st-g" x1="0" y1="0" x2="1" y2="1">
        <stop offset="0" style="stop-color: var(--pli-brand)"></stop>
        <stop offset="1" style="stop-color: var(--pli-brand-2)"></stop>
      </linearGradient>
    </defs>
    <path d="M7 2h10l9 9v12a3 3 0 0 1-3 3H7a3 3 0 0 1-3-3V5a3 3 0 0 1 3-3z" fill="url(#pli-st-g)"></path>
    <path d="M17 2v6a3 3 0 0 0 3 3h6z" fill="#fff" opacity=".35"></path>
    <path d="M10 21v-8h3.6a2.6 2.6 0 0 1 0 5.2H10" fill="none" stroke="#fff" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round"></path>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--pli-ink);
    font: 750 1.25rem/1 var(--pli-font);
    letter-spacing: var(--pli-tracking-tight);
    text-decoration: none;
  }
  .site-title:hover { color: var(--pli-brand); }
  .site-title:focus-visible { outline: 2px solid var(--pli-brand); outline-offset: 4px; border-radius: 6px; }
</style>
