{
  "name": "@pli.dev/pdf",
  "version": "1.1.0",
  "description": "Pli PDF: a headless PDF engine. Reads and writes PDF files, keeps annotations, pages and form values as plain JSON with invertible operations, and saves them back as real PDF.",
  "keywords": [
    "pli",
    "pdf",
    "annotations",
    "forms",
    "headless",
    "editor"
  ],
  "license": "Apache-2.0",
  "author": "Maison de Code (https://maisondecode.com)",
  "homepage": "https://pli.dev",
  "bugs": {
    "url": "https://github.com/MaisonDeCode/pli.dev/issues"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/MaisonDeCode/pli.dev.git",
    "directory": "packages/pdf"
  },
  "type": "module",
  "sideEffects": false,
  "scripts": {
    "build": "tsup",
    "prepack": "node ../../scripts/prepack.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "dependencies": {
    "@pli.dev/core": "workspace:^",
    "@pli.dev/docs": "workspace:^",
    "fflate": "^0.8.2"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "publishConfig": {
    "access": "public",
    "main": "./dist/index.js",
    "module": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js",
        "default": "./dist/index.js"
      },
      "./package.json": "./package.json"
    }
  }
}
